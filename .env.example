# WeVisOne-VL MCP server settings. Copy to .env and edit as needed.
# Process environment variables take precedence over this file.

# Hugging Face model id or a local checkpoint directory.
WEVISONE_MODEL=tencent/WeVisOne-VL-2B

# transformers or vllm.
WEVISONE_BACKEND=transformers

# auto, cuda:0, npu:0 or cpu.
WEVISONE_DEVICE=auto

# Maximum images accepted by one analyze_batch call.
WEVISONE_BATCH_LIMIT=16

# Vision token budget. Lower MAX_PIXELS if the GPU runs out of memory.
WEVISONE_MIN_PIXELS=16384
WEVISONE_MAX_PIXELS=2073600

# Masks decoded per forward pass; lower this on small GPUs.
WEVISONE_DECODER_BATCH_SIZE=16

# Mask-decoder input resolution. Lower this if segmentation or matting runs OOM.
WEVISONE_CNN_SIZE=1024

# Stderr verbosity: DEBUG, INFO, WARNING, ERROR or CRITICAL.
WEVISONE_LOG_LEVEL=INFO
